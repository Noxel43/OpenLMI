{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OpenLMI",
  "version": "0.2.1",
  "identifier": "io.github.noxel43.openlmi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OpenLMI",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "center": true,
        "visible": false,
        "theme": "Dark",
        "backgroundColor": "#0b0c11"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Control LEDs on a microcontroller without writing code",
    "longDescription": "OpenLMI (Open Microcontroller LED Integration) drives addressable LED strips, matrices, cubes and monitor backlights from your PC: built-in effects, an animation editor, screen-ambient lighting, audio-reactive modes and optional scripting.",
    "category": "Utility",
    "copyright": "Copyright (c) 2026 Noxel43 and OpenLMI contributors",
    "license": "MIT",
    "homepage": "https://github.com/Noxel43/OpenLMI",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
